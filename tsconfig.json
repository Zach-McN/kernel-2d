{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "sidecar/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  // Tests of browser-side code belong to the browser project: this one resolves
  // modules the Node way, and the editor's and runtime's own imports carry no
  // `.js` extensions for it to follow.
  "exclude": ["tests/store/**/*.ts", "tests/runtime/**/*.ts", "tests/shell/**/*.ts"]
}
