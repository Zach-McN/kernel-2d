{
  "name": "kernel-2d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable 2D game-editor kernel: runtime, editor, and filesystem sidecar.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "editor": "tsx scripts/editor.ts",
    "sidecar": "tsx sidecar/main.ts",
    "sample-project": "tsx scripts/sample-project.ts",
    "export": "tsx scripts/export.ts",
    "serve": "tsx scripts/serve.ts",
    "dev": "vite",
    "build:editor": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.editor.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "dockview-react": "8.0.0",
    "immer": "11.1.16",
    "phaser": "4.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
